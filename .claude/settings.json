{
  "permissions": {
    "allow": [
      "Bash(.claude/skills/demo-reel-adapter/build.sh)",
      "Bash(.claude/skills/demo-reel-adapter/build.sh *)",
      "Bash(cargo check *)",
      "Bash(gh run view *)",
      "Bash(git grep *)",
      "Bash(gh pr view *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt --check *)",
      "Bash(gh pr checks *)",
      "Bash(cargo xtask linkage-check *)",
      "Bash(git fetch *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh run watch *)",
      "Bash(gh issue list *)",
      "Bash(gh run list *)",
      "Bash(cargo xtask list-tests *)",
      "Bash(gh repo view *)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(gh label list *)",
      "Bash(cargo xtask work-type-check *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-issue-claim.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
