{
  "permissions": {
    "allow": [
      "Bash(.claude/skills/demo-reel-adapter/build.sh)",
      "Bash(.claude/skills/demo-reel-adapter/build.sh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-issue-claim.sh",
            "if": "Bash(gh *)",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
