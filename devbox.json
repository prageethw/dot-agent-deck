{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "vals@0.45.0",
    "go-task@3.48.0",
    "git@2.55.0",
    "upcloud-cli@3.29.0",
    "gh@2.97.0",
    "asciinema@3.2.1",
    "cargo-nextest@0.9.143",
    "rustc@1.97.1",
    "cargo@1.97.1",
    "clippy@1.97.1",
    "rustfmt@1.97.1",
    "path:gcloud#google-cloud-sdk",
    "asciinema-agg@1.9.0",
    "ffmpeg@8.1.2",
    "jq@1.8.2",
    "curl@8.17.0",
    "ripgrep@15.2.0"
  ],
  "shell": {
    "init_hook": [
      "export PATH=\"$HOME/.local/bin:$PATH\"",
      "[ -n \"$DAD_DEV_BIN\" ] && export PATH=\"$DAD_DEV_BIN:$PATH\" || true",
      "[ -n \"$USE_VALS\" ] && eval \"$(vals env -export -f .env.vals.yaml)\" || true",
      "[ -f .env ] && source .env || true"
    ],
    "scripts": {
      "agent": ["claude"],
      "claude-opus-devbox": [
        "claude-opus-devbox \"$@\""
      ],
      "claude-sonnet-devbox": [
        "claude-sonnet-devbox \"$@\""
      ],
      "claude-haiku-devbox": [
        "claude-haiku-devbox \"$@\""
      ],
      "codex-devbox": [
        "codex-devbox \"$@\""
      ]
    }
  }
}
