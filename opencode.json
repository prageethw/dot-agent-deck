{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh"
    }
  },
  "permission": {
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "{env:HOME}/.cargo/**": "allow",
      "{env:HOME}/.rustup/toolchains/**": "allow",
      "*/lib/node_modules": "allow",
      "*/lib/node_modules/*": "allow",
      "{env:HOME}/.local/lib": "allow",
      "{env:HOME}/.local/lib/*": "allow"
    }
  }
}
