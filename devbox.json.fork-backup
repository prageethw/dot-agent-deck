{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "vals@0.46.0",
    "go-task@3.53.1",
    "git@2.55.0",
    "upcloud-cli@3.36.0",
    "gh@2.98.0",
    "asciinema@3.2.1",
    "cargo-nextest@0.9.143",
    "rustc@1.97.1",
    "cargo@1.97.1",
    "clippy@1.97.1",
    "rustfmt@1.97.1",
    "path:gcloud#google-cloud-sdk",
    "asciinema-agg@1.9.0",
    "ffmpeg@9.0.1",
    "jq@1.8.2",
    "curl@8.17.0",
    "ripgrep@15.2.0",
    "python314Packages.pyte@0.8.2",
    "nodejs@24.12.0",
    "pnpm@11.22.0",
    "pkg-config@0.29.2",
    "path:tauri-deps#tauri-deps"
  ],
  "env": {
    "PKG_CONFIG_PATH": "$PWD/.devbox/nix/profile/default/lib/pkgconfig"
  },
  "shell": {
    "init_hook": [
      "export PATH=\"$HOME/.local/bin:$PATH\"",
      "[ -n \"$DAD_DEV_BIN\" ] && export PATH=\"$DAD_DEV_BIN:$PATH\" || true",
      "[ -n \"$USE_VALS\" ] && [ -z \"$GOOGLE_APPLICATION_CREDENTIALS\" ] && [ -f \"$HOME/.config/gcloud/dot-agent-deck-secrets.json\" ] && export GOOGLE_APPLICATION_CREDENTIALS=\"$HOME/.config/gcloud/dot-agent-deck-secrets.json\" || true",
      "[ -n \"$USE_VALS\" ] && eval \"$(vals env -export -f .env.vals.yaml)\" || true",
      "[ -f .env ] && source .env || true"
    ],
    "scripts": {
      "agent": ["claude"],
      "claude-opus-devbox": [
        "claude-opus-devbox \"$@\""
      ],
      "claude-sonnet-devbox": [
        "claude-sonnet-devbox \"$@\""
      ],
      "claude-haiku-devbox": [
        "claude-haiku-devbox \"$@\""
      ],
      "codex-devbox": [
        "codex-devbox \"$@\""
      ],
      "claude-sonnet-devbox-plan": [
        "claude-sonnet-devbox --permission-mode plan \"$@\""
      ],
      "agent-orchestrator": [
        "claude --permission-mode plan \"$@\""
      ],
      "agent-coder": ["claude \"$@\""],
      "agent-reviewer": ["claude --model opus \"$@\""],
      "agent-auditor": ["claude --model opus \"$@\""],
      "agent-tester": ["claude \"$@\""],
      "agent-release": ["claude \"$@\""],
      "agent-orchestrator-oc": ["opencode \"$@\""],
      "agent-coder-oc": ["opencode \"$@\""],
      "agent-reviewer-oc": ["opencode \"$@\""],
      "agent-auditor-oc": ["opencode \"$@\""],
      "agent-tester-oc": ["opencode \"$@\""],
      "oc-release": ["opencode \"$@\""]
    }
  }
}
